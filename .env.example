FCC_AI_BASE_MODEL=openai/whisper-small
# /transcribe 접근을 제한하는 공유 비밀. 터널로 외부에 노출할 때는 반드시 설정하고,
# fcc-backend에도 같은 값을 STT_SERVICE_API_KEY로 넣으세요. 비워두면 검사하지 않습니다.
FCC_AI_API_KEY=
FCC_AI_ADAPTER_PATH=models/whisper-senior-lora
FCC_AI_DEVICE=cuda
FCC_AI_LANGUAGE=korean
FCC_AI_TASK=transcribe
FCC_AI_HOST=0.0.0.0
FCC_AI_PORT=8000
